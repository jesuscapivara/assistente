{
  "name": "assistente",
  "version": "1.19.1",
  "description": "Assistente pessoal ligado ao WhatsApp do Lucas",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp -r src/migrations dist/",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "conectar": "node scripts/conectar.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesuscapivara/assistente.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/jesuscapivara/assistente/issues"
  },
  "homepage": "https://github.com/jesuscapivara/assistente#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "satori": "^0.18.4",
    "unpdf": "1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
