# ── Obrigatórios ────────────────────────────────────────────────────────────────
# Banco (o compose monta o DATABASE_URL a partir desta senha)
POSTGRES_PASSWORD=troque-esta-senha

# Evolution GO que já roda na VM. URL interna, na rede do engine.
EVOLUTION_NETWORK=koreos-infra_default
EVOLUTION_API_URL=http://koreos-evolution:8080
# Só para o scripts/conectar.mjs (criar a instância). O serviço não usa.
EVOLUTION_GLOBAL_API_KEY=
# Token da instância do seu número: gere agora (openssl rand -hex 24). O scripts/conectar.mjs
# cria a instância com ele, e o serviço já sobe pronto para receber o histórico.
EVOLUTION_INSTANCE_TOKEN=

# Segredo do webhook (16+ caracteres). O engine chama http://assistente:3100/webhook/<isto>
WEBHOOK_TOKEN=
WEBHOOK_URL_PUBLICA=http://assistente:3100/webhook/COLOQUE-O-WEBHOOK_TOKEN

# Seu número, só dígitos com DDI. DONO_LIDS: se o chat consigo mesmo vier como LID.
DONO_NUMERO=55
DONO_LIDS=
DONO_NOME=Lucas

ANTHROPIC_API_KEY=
# Voz do dono e perguntas · leitura de cada conversa · fichas, lições, briefing e memória do chat
MODELO=claude-sonnet-5-5
MODELO_EXTRACAO=claude-haiku-5-5
MODELO_LEVE=claude-haiku-5-5

# ── Opcionais ───────────────────────────────────────────────────────────────────
# Áudio: transcrição e comando falado
OPENAI_API_KEY=

# Google (agenda e Gmail): gere com scripts/google.mjs no seu computador
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
EXPEDIENTE=9-18
AGENDA_SINCRONIZAR=1
BRIEFING_MIN=45

# KoreOS pelo MCP (token kore_mcp_… gerado no KoreOS)
KOREOS_MCP_URL=
KOREOS_MCP_TOKEN=

# Autonomia: nível de quem não tem nível próprio (0 só quando você pede … 3 envia o simples)
AUTONOMIA_PADRAO=0
JANELA_VETO_MIN=10
COBRAR_APOS_DIAS=3

# Painel web (24+ caracteres). Sem isso, o painel não existe.
PAINEL_TOKEN=

FUSO=America/Sao_Paulo
RESUMO_HORA=07:30
# Resumo da manhã em imagem (0 = só texto). A Evolution busca a imagem no assistente:
# URL_INTERNA é esse endereço na rede do Docker (sem ela, vale a origem de WEBHOOK_URL_PUBLICA).
RESUMO_IMAGEM=1
URL_INTERNA=
RETENCAO_DIAS=365
