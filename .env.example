# Banco (o compose monta o DATABASE_URL a partir desta senha)
POSTGRES_PASSWORD=troque-esta-senha

# Evolution GO que já roda na VM. URL interna, na rede do engine.
EVOLUTION_NETWORK=koreos-infra_default
EVOLUTION_API_URL=http://koreos-evolution:8080
# Só para o `npm run conectar` (criar a instância). O serviço não usa.
EVOLUTION_GLOBAL_API_KEY=
# Gerado pelo `npm run conectar`.
EVOLUTION_INSTANCE_TOKEN=

# Segredo do webhook (16+ caracteres). O engine chama http://assistente:3100/webhook/<isto>
WEBHOOK_TOKEN=
WEBHOOK_URL_PUBLICA=http://assistente:3100/webhook/COLOQUE-O-WEBHOOK_TOKEN

# Seu número, só dígitos com DDI. DONO_LIDS: se o chat consigo mesmo vier como LID.
DONO_NUMERO=55
DONO_LIDS=
DONO_NOME=Lucas

ANTHROPIC_API_KEY=
MODELO=claude-opus-5-5
MODELO_EXTRACAO=claude-opus-5-5

# Opcional: transcrever áudios
OPENAI_API_KEY=

FUSO=America/Sao_Paulo
RESUMO_HORA=07:30
RETENCAO_DIAS=365
